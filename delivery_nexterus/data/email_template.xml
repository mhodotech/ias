<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!-- Email Template for Carrier Closed Notification -->
    <record id="email_template_carrier_closed" model="mail.template">
      <field name="name">Carrier Closed Notification</field>
      <field name="model_id" ref="delivery_nexterus.model_close_carrier_wizard"/>
      <field name="subject">Carriers Closed - {{ object.create_date.strftime('%Y-%m-%d') }}</field>
      <field name="email_from">{{ user.email_formatted or user.company_id.email }}</field>
      <field name="auto_delete" eval="False"/>
      <field name="body_html" type="html">
        <div style="font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 14px; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);">
          <h3>Carrier Close Notification</h3>

          <p>The following carriers have been closed:</p>

          <p><strong>Carriers:</strong> <t t-out="object.carrier_names or 'N/A'"/></p>

          <p><strong>Delivery Orders:</strong></p>
          <ul>
            <t t-foreach="object.picking_ids" t-as="picking">
              <li>
                <t t-out="picking.name"/> -
                <t t-out="picking.partner_id.name"/>
                (<t t-out="picking.carrier_id.name or 'No Carrier'"/>)
              </li>
            </t>
          </ul>

          <p><strong>Number of Orders:</strong> <t t-out="len(object.picking_ids)"/></p>
          <p><strong>Closed Date:</strong> <t t-out="object.create_date.strftime('%Y-%m-%d %H:%M:%S')"/></p>
          <p><strong>Closed By:</strong> <t t-out="object.create_uid.name"/></p>

          <hr/>
          <p style="color: #888; font-size: 12px;">
            This is an automated notification from the Nexterus Shipping Integration system.
          </p>
        </div>
      </field>
    </record>
  </data>
</odoo>