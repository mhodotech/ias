<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- List View -->
  <record id="view_carrier_close_config_list" model="ir.ui.view">
    <field name="name">carrier.close.config.list</field>
    <field name="model">carrier.close.config</field>
    <field name="arch" type="xml">
      <list string="Carrier Close Email Configuration" editable="bottom">
        <field name="email" required="1"/>
        <field name="name"/>
        <field name="active"/>
        <field name="notes"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_carrier_close_config_form" model="ir.ui.view">
    <field name="name">carrier.close.config.form</field>
    <field name="model">carrier.close.config</field>
    <field name="arch" type="xml">
      <form string="Email Configuration">
        <sheet>
          <group>
            <group>
              <field name="email" required="1"/>
              <field name="name"/>
            </group>
            <group>
              <field name="active"/>
            </group>
          </group>
          <group string="Notes">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_carrier_close_config" model="ir.actions.act_window">
    <field name="name">Carrier Close Email Configuration</field>
    <field name="res_model">carrier.close.config</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Configure email recipients for carrier close notifications
      </p>
      <p>
        Add email addresses that should be notified when carriers are closed.
        Each recipient will receive an individual email with the list of carriers
        and delivery orders that were closed.
      </p>
    </field>
  </record>

  <!-- Menu under Inventory Configuration -->
  <menuitem id="menu_carrier_close_config"
            name="Carrier Close Emails"
            parent="stock.menu_warehouse_config"
            action="action_carrier_close_config"
            sequence="100"
            groups="stock.group_stock_manager"/>
</odoo>