<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Existing Order Sync Cron -->
        <record id="ir_cron_gp_sync_orders" model="ir.cron">
            <field name="name">GP: Sync Sales Orders</field>
            <field name="model_id" ref="model_gp_sync_service"/>
            <field name="state">code</field>
            <field name="code">model.sync_all_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- New Product Sync Cron -->
        <record id="ir_cron_gp_sync_products" model="ir.cron">
            <field name="name">GP: Sync Products</field>
            <field name="model_id" ref="model_gp_product_sync"/>
            <field name="state">code</field>
            <field name="code">model.sync_all_products()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>