<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Existing Order Sync Functions -->
        <record id="job_function_sync_all_orders" model="queue.job.function">
            <field name="model_id" ref="model_gp_sync_service"/>
            <field name="method">sync_all_orders</field>
            <field name="channel_id" ref="channel_gp_sync"/>
        </record>

        <record id="job_function_sync_specific_order" model="queue.job.function">
            <field name="model_id" ref="model_gp_sync_service"/>
            <field name="method">sync_specific_order</field>
            <field name="channel_id" ref="channel_gp_sync"/>
        </record>

        <!-- New Product Sync Function -->
        <record id="job_function_sync_all_products" model="queue.job.function">
            <field name="model_id" ref="model_gp_product_sync"/>
            <field name="method">sync_all_products</field>
            <field name="channel_id" ref="channel_gp_sync"/>
        </record>
    </data>
</odoo>