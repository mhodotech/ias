<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Create our own category since sales_management doesn't exist -->
        <record id="module_category_gp_integration" model="ir.module.category">
            <field name="name">GP Integration</field>
            <field name="description">GP Sales Order Integration</field>
            <field name="sequence">50</field>
        </record>

        <record id="gp_integration_group_user" model="res.groups">
            <field name="name">GP Integration / User</field>
            <field name="category_id" ref="module_category_gp_integration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="gp_integration_group_manager" model="res.groups">
            <field name="name">GP Integration / Manager</field>
            <field name="category_id" ref="module_category_gp_integration"/>
            <field name="implied_ids" eval="[(4, ref('gp_integration_group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>