<odoo>
    <record id="view_gp_config_form" model="ir.ui.view">
        <field name="name">gp.config.form</field>
        <field name="model">gp.config</field>
        <field name="arch" type="xml">
            <form string="GP Configuration">
                <header>
                    <!-- Button in header for better visibility -->
                    <button name="test_connection" type="object"
                            string="Test Connection" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Production GP"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Database Connection">
                            <field name="server"/>
                            <field name="database"/>
                            <field name="port"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="tds_version"/>
                            <field name="active"/>
                        </group>
                        <group string="Sync Settings">
                            <field name="auto_create_products"/>
                            <field name="auto_create_customers"/>
                            <field name="default_location_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gp_config_list" model="ir.ui.view">
        <field name="name">gp.config.list</field>
        <field name="model">gp.config</field>
        <field name="arch" type="xml">
            <list string="GP Configurations">
                <field name="name"/>
                <field name="server"/>
                <field name="database"/>
                <field name="active"/>
                <button name="test_connection" type="object"
                        string="Test" class="btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="action_gp_config" model="ir.actions.act_window">
        <field name="name">GP Configuration</field>
        <field name="res_model">gp.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>