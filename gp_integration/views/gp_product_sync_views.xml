<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Sync Model Views -->
    <record id="view_gp_product_sync_form" model="ir.ui.view">
        <field name="name">gp.product.sync.form</field>
        <field name="model">gp.product.sync</field>
        <field name="arch" type="xml">
            <form string="Product Sync">
                <header>
                    <field name="sync_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Sync Information">
                            <field name="last_sync_date"/>
                            <field name="products_synced"/>
                            <field name="products_created"/>
                            <field name="products_updated"/>
                        </group>
                        <group string="Status">
                            <field name="sync_status"/>
                            <field name="error_message" invisible="sync_status != 'error'"/>
                        </group>
                    </group>
                </sheet>
                <chatter
                    track="message_ids"
                    followers="message_follower_ids"
                    activities="activity_ids"
                />
            </form>
        </field>
    </record>

    <record id="view_gp_product_sync_list" model="ir.ui.view">
        <field name="name">gp.product.sync.list</field>
        <field name="model">gp.product.sync</field>
        <field name="arch" type="xml">
            <list string="Product Sync History">
                <field name="name"/>
                <field name="last_sync_date"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'success'"
                       decoration-warning="sync_status == 'running'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="products_synced"/>
                <field name="products_created"/>
                <field name="products_updated"/>
            </list>
        </field>
    </record>

    <!-- Product Sync Wizard Views -->
    <record id="view_gp_product_sync_wizard" model="ir.ui.view">
        <field name="name">gp.product.sync.wizard.form</field>
        <field name="model">gp.product.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Products from GP">
                <group>
                    <field name="sync_mode" widget="radio"/>
                    <field name="specific_itemnmbr"
                           invisible="sync_mode != 'specific'"
                           required="sync_mode == 'specific'"
                           placeholder="e.g., ITEM001"/>
                </group>
                <group>
                    <group string="Sync Options">
                        <field name="sync_inventory"/>
                        <field name="sync_lots_serials"/>
                        <field name="create_adjustments"/>
                    </group>
                    <group string="Processing">
                        <field name="use_queue" widget="boolean_toggle"/>
                    </group>
                </group>
                <footer>
                    <button name="action_sync"
                            type="object"
                            string="Sync Now"
                            class="btn-primary"/>
                    <button name="action_sync_and_view"
                            type="object"
                            string="Sync and View Results"
                            class="btn-secondary"
                            invisible="use_queue"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_gp_product_sync" model="ir.actions.act_window">
        <field name="name">Product Sync History</field>
        <field name="res_model">gp.product.sync</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gp_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Products from GP</field>
        <field name="res_model">gp.product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server Action for Sync All Products -->
    <record id="action_server_sync_all_products" model="ir.actions.server">
        <field name="name">Sync All Products from GP</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
            action = env['gp.product.sync'].action_open_sync_wizard()
        </field>
    </record>
</odoo>