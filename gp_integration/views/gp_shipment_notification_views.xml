<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gp_shipment_notification_tree" model="ir.ui.view">
        <field name="name">gp.shipment.notification.list</field>
        <field name="model">gp.shipment.notification</field>
        <field name="arch" type="xml">
            <list string="GP Shipment Notifications">
                <field name="create_date"/>
                <field name="gp_sopnumbe"/>
                <field name="odoo_delivery_name"/>
                <field name="ship_date"/>
                <field name="status"/>
                <field name="ready_for_invoice"/>
                <field name="processed" widget="boolean_toggle"/>
                <field name="processed_date"/>
            </list>
        </field>
    </record>

    <record id="view_gp_shipment_notification_form" model="ir.ui.view">
        <field name="name">gp.shipment.notification.form</field>
        <field name="model">gp.shipment.notification</field>
        <field name="arch" type="xml">
            <form string="GP Shipment Notification">
                <sheet>
                    <group>
                        <group string="Order Information">
                            <field name="gp_sopnumbe" readonly="1"/>
                            <field name="odoo_delivery_name" readonly="1"/>
                            <field name="ship_date" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="ready_for_invoice" readonly="1"/>
                        </group>
                        <group string="Shipping Details">
                            <field name="tracking_numbers" readonly="1"/>
                            <field name="carrier_name" readonly="1"/>
                        </group>
                    </group>
                    <group string="Processing Status">
                        <field name="processed" readonly="1"/>
                        <field name="processed_date" readonly="1"/>
                        <field name="error_message" readonly="1" invisible="not error_message"/>
                    </group>
                    <group string="Line Items" invisible="not line_items">
                        <field name="line_items" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gp_shipment_notification" model="ir.actions.act_window">
        <field name="name">GP Shipment Notifications</field>
        <field name="res_model">gp.shipment.notification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No shipment notifications yet
            </p>
            <p>
                Shipment notifications are created automatically when delivery orders are validated.
            </p>
        </field>
    </record>
</odoo>