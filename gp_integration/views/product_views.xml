<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_form_gp_inherit" model="ir.ui.view">
        <field name="name">product.template.form.gp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="GP Info" name="gp_info"
                      invisible="not gp_itemnmbr">
                    <group>
                        <group string="GP References">
                            <field name="gp_itemnmbr" readonly="1"/>
                            <field name="gp_itmclscd" readonly="1"/>
                            <field name="gp_itmtrkop" readonly="1"/>
                            <field name="gp_last_sync" readonly="1"/>
                        </group>
                        <group string="GP Description">
                            <field name="gp_itemdesc" readonly="1"/>
                        </group>
                    </group>
                    <group string="Actions">
                        <button name="sync_from_gp"
                                type="object"
                                string="Sync from GP"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_product_list_gp_inherit" model="ir.ui.view">
        <field name="name">product.template.list.gp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="gp_itemnmbr" optional="show"/>
                <field name="gp_last_sync" optional="hide" widget="datetime"/>
            </field>
        </field>
    </record>

    <!-- Add search filters -->
    <record id="view_product_search_gp_inherit" model="ir.ui.view">
        <field name="name">product.template.search.gp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="gp_itemnmbr"/>
                <separator/>
                <filter string="GP Products" name="gp_products"
                        domain="[('gp_itemnmbr', '!=', False)]"/>
                <filter string="Non-GP Products" name="non_gp_products"
                        domain="[('gp_itemnmbr', '=', False)]"/>
                <separator/>
                <filter string="GP Lot Tracked" name="gp_lot_tracked"
                        domain="[('gp_itmtrkop', '=', '2')]"/>
                <filter string="GP Serial Tracked" name="gp_serial_tracked"
                        domain="[('gp_itmtrkop', '=', '1')]"/>
            </search>
        </field>
    </record>
</odoo>