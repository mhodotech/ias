<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gp_product_sync_wizard" model="ir.ui.view">
        <field name="name">gp.product.sync.wizard.form</field>
        <field name="model">gp.product.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Products from GP">
                <div class="alert alert-info" role="alert">
                    <p><i class="fa fa-info-circle"/> This will synchronize products from GP including:</p>
                    <ul>
                        <li>Product information and descriptions</li>
                        <li>Lot and serial number tracking settings</li>
                        <li>Current inventory quantities</li>
                        <li>Lot numbers with expiration dates</li>
                        <li>Available serial numbers</li>
                    </ul>
                </div>
                <group>
                    <field name="sync_mode" widget="radio"/>
                    <field name="specific_itemnmbr"
                           invisible="sync_mode != 'specific'"
                           required="sync_mode == 'specific'"
                           placeholder="e.g., ITEM001"/>
                </group>
                <group>
                    <group string="Sync Options">
                        <field name="sync_inventory" widget="boolean_toggle"/>
                        <field name="sync_lots_serials" widget="boolean_toggle"/>
                        <field name="create_adjustments" widget="boolean_toggle"/>
                    </group>
                    <group string="Processing">
                        <field name="use_queue" widget="boolean_toggle"/>
                    </group>
                </group>
                <footer>
                    <button name="action_sync"
                            type="object"
                            string="Sync Now"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_sync_and_view"
                            type="object"
                            string="Sync and View Results"
                            class="btn-secondary"
                            invisible="use_queue"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gp_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Products from GP</field>
        <field name="res_model">gp.product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>