<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gp_sync_wizard" model="ir.ui.view">
        <field name="name">gp.sync.wizard.form</field>
        <field name="model">gp.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="GP Synchronization">
                <group>
                    <field name="sync_type" widget="radio"/>
                    <field name="sopnumbe"
                           invisible="sync_type != 'specific'"
                           required="sync_type == 'specific'"
                           placeholder="e.g., M267998"/>
                    <field name="date_from"
                           invisible="sync_type != 'date_range'"
                           required="sync_type == 'date_range'"/>
                    <field name="date_to"
                           invisible="sync_type != 'date_range'"
                           required="sync_type == 'date_range'"/>
                    <field name="use_queue" widget="boolean_toggle"/>
                </group>
                <footer>
                    <button name="action_sync" type="object"
                            string="Sync Now" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gp_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync from GP</field>
        <field name="res_model">gp.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
