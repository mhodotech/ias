<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Paper format for container label (Custom size for label printers) -->
        <record id="paperformat_container_label" model="report.paperformat">
            <field name="name">Container Label (6x4 inch)</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">152</field>
            <field name="page_width">102</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>