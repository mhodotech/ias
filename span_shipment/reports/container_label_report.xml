<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Stock Picking -->
    <record id="action_report_container_label_picking" model="ir.actions.report">
        <field name="name">Container Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">span_shipment.report_container_label_picking</field>
        <field name="report_file">span_shipment.report_container_label_picking</field>
        <field name="print_report_name">'Container Label - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="paperformat_id" ref="span_shipment.paperformat_container_label"/>
    </record>

    <!-- Report Action for Stock Picking Batch -->
    <record id="action_report_container_label_batch" model="ir.actions.report">
        <field name="name">Container Labels</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">span_shipment.report_container_label_batch</field>
        <field name="report_file">span_shipment.report_container_label_batch</field>
        <field name="print_report_name">'Container Labels - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="paperformat_id" ref="span_shipment.paperformat_container_label"/>
    </record>
</odoo>