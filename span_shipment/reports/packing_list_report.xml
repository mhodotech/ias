<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Stock Picking -->
    <record id="action_report_packing_list_picking" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">span_shipment.report_packing_list_picking</field>
        <field name="report_file">span_shipment.report_packing_list_picking</field>
        <field name="print_report_name">'Packing List - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <!-- Report Action for Stock Picking Batch -->
    <record id="action_report_packing_list_batch" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">span_shipment.report_packing_list_batch</field>
        <field name="report_file">span_shipment.report_packing_list_batch</field>
        <field name="print_report_name">'Packing List - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
</odoo>