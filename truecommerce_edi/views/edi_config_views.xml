<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_config_form" model="ir.ui.view">
        <field name="name">edi.config.form</field>
        <field name="model">edi.config</field>
        <field name="arch" type="xml">
            <form string="EDI Configuration">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_name"/>
                            <field name="company_code"/>
                        </group>
                        <group string="File Settings">
                            <field name="output_path" required="1"/>
                            <field name="archive_path"/>
                            <field name="file_prefix"/>
                            <field name="file_extension"/>
                        </group>
                    </group>
                    <group>
                        <group string="EDI Standards">
                            <field name="sender_id" required="1"/>
                            <field name="sender_id_qualifier" required="1"/>
                            <field name="receiver_id_qualifier"/>
                            <field name="edi_version"/>
                        </group>
                        <group string="Processing Options">
                            <field name="group_by_customer"/>
                            <field name="include_serial_numbers"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edi_config_list" model="ir.ui.view">
        <field name="name">edi.config.list</field>
        <field name="model">edi.config</field>
        <field name="arch" type="xml">
            <list string="EDI Configurations">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="output_path"/>
                <field name="sender_id"/>
                <field name="edi_version"/>
            </list>
        </field>
    </record>

    <record id="action_edi_config" model="ir.actions.act_window">
        <field name="name">EDI Configuration</field>
        <field name="res_model">edi.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>