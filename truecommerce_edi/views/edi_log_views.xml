<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_log_list" model="ir.ui.view">
        <field name="name">edi.log.list</field>
        <field name="model">edi.log</field>
        <field name="arch" type="xml">
            <list string="EDI Generation Logs">
                <field name="create_date"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="file_name"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"/>
                <field name="control_number"/>
            </list>
        </field>
    </record>

    <record id="view_edi_log_form" model="ir.ui.view">
        <field name="name">edi.log.form</field>
        <field name="model">edi.log</field>
        <field name="arch" type="xml">
            <form string="EDI Log">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="picking_id"/>
                            <field name="partner_id"/>
                            <field name="file_name"/>
                            <field name="file_path"/>
                            <field name="status"/>
                        </group>
                        <group string="Details">
                            <field name="control_number"/>
                            <field name="transaction_count"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Error Message" invisible="status != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="File Content">
                        <field name="file_content" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edi_log_search" model="ir.ui.view">
        <field name="name">edi.log.search</field>
        <field name="model">edi.log</field>
        <field name="arch" type="xml">
            <search string="EDI Logs">
                <field name="file_name"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date', '>=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"/>
                <filter string="This Week" name="week"
                        domain="[('create_date', '>=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edi_log" model="ir.actions.act_window">
        <field name="name">EDI Logs</field>
        <field name="res_model">edi.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edi_log_search"/>
    </record>
</odoo>